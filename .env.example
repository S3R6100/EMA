# ==========================================
# Variables de Entorno - EMA VPS Deployment
# ==========================================

# 1. Base de datos (Dentro de docker, usa "db:5432". Localmente usábamos "localhost:54320")
DATABASE_URL="postgresql://postgres:password@db:5432/ema?schema=public"

# 2. Puerto del Backend
PORT=4000

# 3. URL del Backend para el Frontend (Debe ser la IP de tu VPS o el dominio)
# Descomenta esto en tu VPS y cámbialo por tu IP pública:
# VITE_API_URL=http://TUPUBLICAIP:4000
